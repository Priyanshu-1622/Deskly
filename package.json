{
  "name": "deskly",
  "productName": "Deskly",
  "version": "0.1.0",
  "description": "A first-person 3D office where AI employees do real work on your projects.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Priyanshu Patel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyanshu-1622/Deskly.git"
  },
  "keywords": [
    "ai-agents",
    "electron",
    "threejs",
    "productivity",
    "first-person",
    "llm"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "eslint src tools test",
    "smoke": "node tools/visual-smoke.cjs",
    "check": "npm run lint && npm test",
    "repo:check": "node tools/repository-check.cjs",
    "smoke:release-prep": "node tools/release-smoke.cjs",
    "audit:deps": "node tools/dependency-audit.cjs",
    "release:check": "npm run check && npm run repo:check && npm run audit:deps && npm run smoke && npm run smoke:release-prep",
    "providers:live": "node tools/provider-check.cjs",
    "benchmark:agents": "node tools/agent-benchmark.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5"
  },
  "build": {
    "appId": "dev.deskly.app",
    "productName": "Deskly",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "SECURITY.md",
      "RELEASE_POLICY.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/ASSET_CREDITS.md",
      "docs/PRIVACY.md",
      "docs/USER-GUIDE.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "afterPack": "tools/after-pack.cjs",
    "asar": true
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
